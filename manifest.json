{
  "manifest_version": 3,
  "name": "Gemini Live Avatar",
  "version": "0.1.0",
  "description": "A small, draggable Gemini 3.8 Live Avatar that floats over any web page, sees what's on it, and talks with you.",
  "minimum_chrome_version": "116",
  "permissions": ["offscreen", "scripting", "storage", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Show / hide the Gemini Live Avatar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["avatar-frame.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
